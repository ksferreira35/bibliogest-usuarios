.git
target
deploy
.env*
*.local

# BiblioGest: configurações locais, credenciais e backups
**/.env
**/.env.*
**/*.local.json
**/*.local.yaml
**/*.local.yml
**/*.local.properties
**/application-local.*
**/.local/
**/rendered/
**/.kube/
**/kubeconfigs/
**/kubeconfig
**/kubeconfig.*
**/*.kubeconfig
**/.ssh/
**/.aws/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/.pgpass
**/.pg_service.conf
**/*.dump
**/*.backup
**/*.backup.*
**/*.dump.*
**/*.bak
**/backups/
**/dumps/
**/*.sql
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.sql.zip
# Exemplos não contêm credenciais; migrations são código versionado.
!**/.env.example
!**/.env.*.example
!**/.env.sample
!**/.env.*.sample
!**/*.example.json
!**/*.example.yaml
!**/*.example.yml
!**/db/migration/**/*.sql

# Backups do editor
**/*~

# Documentação
README.md
**/README.md
